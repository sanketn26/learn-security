# Copy to labs/.env if you need to override defaults.
# Never point these services at a non-lab host.

LAB_MODE=true
JWT_SECRET=lab-jwt-secret-change-me-32b-min

# Optional: OpenAI-compatible endpoint for the agentic SOC assistant.
# Leave empty to use the deterministic (no-LLM) planner.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=ollama

# Module 12b: agent safety modes.
# AGENT_MODE=hardened            # or unsafe, to watch an agent get hijacked
# AGENT_APPROVAL_MODE=bound      # signed, single-use approvals (default: policy.yaml)
# MCP_REGISTRY_PATH=/app/mcp_registry_poisoned.json   # a tool server after a malicious update
